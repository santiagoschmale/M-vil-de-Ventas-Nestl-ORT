{
  "name": "motor-distribucion",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "node scripts/dev.js",
    "dev:web": "npm run dev -w @motor/web",
    "dev:api": "npm run dev -w @motor/api",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "db:migrate": "npm run migrate -w @motor/db",
    "db:generate": "npm run generate -w @motor/db",
    "db:studio": "npm run studio -w @motor/db",
    "build": "npm run build -w @motor/shared && npm run build -w @motor/db && npm run build -w @motor/api && npm run build -w @motor/web",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "concurrently": "^9.1.0",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "prettier": "^3.9.8",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.70.1"
  },
  "engines": {
    "node": ">=20"
  }
}
